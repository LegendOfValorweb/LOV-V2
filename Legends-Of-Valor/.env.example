# ─────────────────────────────────────────────────────────────
#  Legends of Valor — Environment Variables
#  Copy this file to .env and fill in the values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=development          # "development" | "production"
PORT=5000                     # Port the Express server listens on

# ── Database ─────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Local example:  postgresql://postgres:password@localhost:5432/legends_of_valor
# Neon example:   postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/legends_of_valor

# ── Authentication ────────────────────────────────────────────
# Long, random secret used to sign JWT tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ── CORS ──────────────────────────────────────────────────────
# Exact origin URL of the deployed frontend (no trailing slash).
# In production this must be your Vercel URL, e.g. https://legends-of-valor.vercel.app
# In development you can leave this blank — localhost origins are allowed automatically.
FRONTEND_URL=https://your-frontend.vercel.app

# ── AI (Google Gemini) ────────────────────────────────────────
# Required for the AI Game Master feature.
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-generative-ai-api-key

# ── Static file serving (optional) ───────────────────────────
# Set to "true" if you want the backend to also serve the
# compiled frontend from dist/public (single-server deployment).
# Leave unset for the recommended split deployment
# (Vercel frontend + Railway/Render backend).
# SERVE_STATIC=true
